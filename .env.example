# Django
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# In cloud hosting (Railway / Render), set DATABASE_URL instead of POSTGRES_*
# DATABASE_URL=postgresql://user:password@host:5432/finova
USE_SQLITE=False
POSTGRES_DB=finova
POSTGRES_USER=finova
POSTGRES_PASSWORD=finova_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
